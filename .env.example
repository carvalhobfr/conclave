# Conclave runtime
# Copy to .env, keep real credentials out of version control, and enable one mode.

# Free configuration — OpenCode Zen through the OpenAI-compatible adapter.
# This is a configurable boundary, not a publicly hosted Conclave service.
# Models, availability, quotas, and data handling are provider-controlled.
# Selected repository excerpts may be sent to this external provider.
CONCLAVE_MODE=free
CONCLAVE_FREE_PROVIDER=openai
CONCLAVE_FREE_BASE_URL=https://opencode.ai/zen/v1
CONCLAVE_FREE_API_KEY=
CONCLAVE_FREE_MODEL=deepseek-v4-flash-free
CONCLAVE_FREE_MODEL_ALLOWLIST=deepseek-v4-flash-free,nemotron-3-ultra-free,north-mini-code-free
CONCLAVE_PROVIDER_TIMEOUT_MS=180000

# Optional Free usage controls enforced by this local product-service process.
CONCLAVE_FREE_REQUESTS_PER_WINDOW=20
CONCLAVE_FREE_WINDOW_MS=3600000
CONCLAVE_FREE_MAX_CONCURRENCY=2

# Opt-in only: exercise Ask and Investigate against the committed fixture.
# CONCLAVE_ZEN_FULL_SMOKE=1

# API Mode — bring your own key for an OpenAI-compatible HTTPS endpoint.
# CONCLAVE_MODE=api
# CONCLAVE_PROVIDER=openai
# CONCLAVE_BASE_URL=https://api.openai.com/v1
# CONCLAVE_API_KEY=
# CONCLAVE_MODEL=gpt-5-mini
# CONCLAVE_PROVIDER_TIMEOUT_MS=60000

# OpenRouter BYOK — also uses the OpenAI-compatible adapter.
# An OpenRouter API key is required even when selecting a currently free model.
# Do not hardcode provider catalog assumptions; set a model ID available to your key.
# CONCLAVE_MODE=api
# CONCLAVE_PROVIDER=openrouter
# CONCLAVE_BASE_URL=https://openrouter.ai/api/v1
# CONCLAVE_MODEL=<openrouter-model-id>
# CONCLAVE_API_KEY=

# Local Mode — loopback-only Ollama, LM Studio, or OpenAI-compatible endpoint.
# CONCLAVE_MODE=local
# CONCLAVE_PROVIDER=ollama
# CONCLAVE_BASE_URL=http://127.0.0.1:11434/v1
# CONCLAVE_MODEL=qwen3-coder
# LM Studio alternative: set provider to lm-studio and base URL to
# http://127.0.0.1:1234/v1.

# Embeddings remain separate from chat inference. The default is deterministic,
# offline feature hashing (provider ID: conclave-local-hash-v1).
CONCLAVE_EMBEDDING_MODE=feature-hash
# CONCLAVE_EMBEDDING_MODE=openai-compatible
# CONCLAVE_EMBEDDING_MODEL=nomic-embed-text
# CONCLAVE_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# CONCLAVE_EMBEDDING_DIMENSIONS=768
# CONCLAVE_EMBEDDING_API_KEY=

# Full reasoning is available, while the deterministic router may use many,
# one, or zero model calls depending on Project Knowledge.
CONCLAVE_REASONING_PRESET=full

# Optional host/user capability registry for deterministic role-to-model selection.
# Explicit role assignments remain authoritative. Fallback is disabled unless enabled.
# CONCLAVE_MODEL_FALLBACK_POLICY=configured
# CONCLAVE_MODEL_PROFILES_JSON=[{"providerId":"openai","modelId":"configured-model","capabilities":{"reasoning":"high","coding":"medium","speed":"medium","context":"large"},"costClass":"standard"}]

# Free configuration role ensemble. Provider/model overrides inherit the active mode's
# endpoint and credential; credentials are never copied into role configuration.
# These checked-in model IDs are current provider configuration, not permanent
# claims about availability or the best model for a role.
CONCLAVE_INVESTIGATOR_PROVIDER=openai
CONCLAVE_INVESTIGATOR_MODEL=deepseek-v4-flash-free
CONCLAVE_SKEPTIC_PROVIDER=openai
CONCLAVE_SKEPTIC_MODEL=nemotron-3-ultra-free
CONCLAVE_ARCHITECT_PROVIDER=openai
CONCLAVE_ARCHITECT_MODEL=nemotron-3-ultra-free
CONCLAVE_VERIFIER_PROVIDER=openai
CONCLAVE_VERIFIER_MODEL=deepseek-v4-flash-free
CONCLAVE_JUDGE_PROVIDER=openai
CONCLAVE_JUDGE_MODEL=nemotron-3-ultra-free

# Optional Conductor. Leave unset for deterministic host planning.
# CONCLAVE_ENABLE_CONDUCTOR=true
# CONCLAVE_CONDUCTOR_PROVIDER=openai
# CONCLAVE_CONDUCTOR_MODEL=deepseek-v4-flash-free

# Task Mode role ensemble. Task execution still requires explicit capabilities.
CONCLAVE_PLANNER_PROVIDER=openai
CONCLAVE_PLANNER_MODEL=nemotron-3-ultra-free
CONCLAVE_IMPLEMENTER_PROVIDER=openai
CONCLAVE_IMPLEMENTER_MODEL=north-mini-code-free
CONCLAVE_REVIEWER_PROVIDER=openai
CONCLAVE_REVIEWER_MODEL=deepseek-v4-flash-free
CONCLAVE_ALLOWED_PACKAGE_SCRIPTS=test,typecheck

# Mix & Match: each role may point at a different registered provider/model.
# Presets and the default assignments above are sufficient for ordinary use;
# per-role overrides are optional advanced configuration.

# Local web app. Use private absolute paths in your own .env.
CONCLAVE_WEB_ALLOWED_ROOT=/absolute/path/to/repositories
CONCLAVE_WEB_PORT=4317
# CONCLAVE_SETTINGS_FILE=/absolute/path/to/conclave-settings.json

# MCP remains read-only; its repository root must be below this host boundary.
# CONCLAVE_MCP_ALLOWED_ROOT=/absolute/path/to/repositories
