# Hosted Free Mode: credentials stay in the server process.
CONCLAVE_MODE=free
CONCLAVE_FREE_PROVIDER=openai
CONCLAVE_FREE_MODEL=
CONCLAVE_FREE_API_KEY=

# API Mode (BYOK): inject the credential into the process; do not save it in app state.
# CONCLAVE_MODE=api
# CONCLAVE_PROVIDER=openai
# CONCLAVE_MODEL=
# CONCLAVE_API_KEY=

# Local Mode defaults to an Ollama OpenAI-compatible endpoint.
# CONCLAVE_MODE=local
# CONCLAVE_PROVIDER=ollama
# CONCLAVE_MODEL=
# CONCLAVE_BASE_URL=http://127.0.0.1:11434/v1

# Optional learned embeddings. The default is deterministic conclave-local-hash-v1.
# Configure all fields explicitly; Conclave never silently switches embedding strategy.
# CONCLAVE_EMBEDDING_MODE=openai-compatible
# CONCLAVE_EMBEDDING_MODEL=nomic-embed-text
# CONCLAVE_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# CONCLAVE_EMBEDDING_DIMENSIONS=768

# Reasoning role overrides. Omit these to use the active mode's provider/model.
# CONCLAVE_REASONING_PRESET=full
# CONCLAVE_INVESTIGATOR_PROVIDER=openai
# CONCLAVE_INVESTIGATOR_MODEL=
# CONCLAVE_SKEPTIC_PROVIDER=openai
# CONCLAVE_SKEPTIC_MODEL=
# CONCLAVE_ARCHITECT_PROVIDER=openai
# CONCLAVE_ARCHITECT_MODEL=
# CONCLAVE_VERIFIER_PROVIDER=openai
# CONCLAVE_VERIFIER_MODEL=
# CONCLAVE_JUDGE_PROVIDER=openai
# CONCLAVE_JUDGE_MODEL=

# Task Mode role overrides. Task Mode is plan-only unless CLI permissions are explicit.
# CONCLAVE_PLANNER_PROVIDER=openai
# CONCLAVE_PLANNER_MODEL=
# CONCLAVE_IMPLEMENTER_PROVIDER=openai
# CONCLAVE_IMPLEMENTER_MODEL=
# CONCLAVE_REVIEWER_PROVIDER=openai
# CONCLAVE_REVIEWER_MODEL=

# Host allowlist for package-script capability requests (comma-separated).
# A listed script still requires --allow-checks --allow-repository-scripts --allow-network.
# CONCLAVE_ALLOWED_PACKAGE_SCRIPTS=test,typecheck

# Local web application boundary. The browser may request only folders beneath this root.
# The local server binds to 127.0.0.1 only; it does not expose a hosted Free Mode.
# CONCLAVE_WEB_ALLOWED_ROOT=/absolute/path/containing/repositories
# CONCLAVE_WEB_PORT=4317

# Read-only MCP server boundary. Start with: conclave mcp /path/to/repository
# CONCLAVE_MCP_ALLOWED_ROOT=/absolute/path/containing/repositories
